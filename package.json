{
  "name": "quest-fee-service",
  "version": "0.1.0",
  "private": true,
  "description": "Tiny subscription service with one user-facing flow and deliberately labelled defects, for a quality/maintainability assessment.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "metrics": "tsx scripts/metrics.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
